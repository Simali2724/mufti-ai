# Mufti AI — Environment Configuration
# Copy this to .env and fill in your values

# --- REQUIRED ---
GOOGLE_API_KEY=              # Get free from https://aistudio.google.com/apikey

# --- CLOUD DEPLOYMENT (set these for Render/cloud hosting) ---
DEPLOY_MODE=cloud            # 'cloud' disables Ollama-dependent features
EMBEDDING_PROVIDER=gemini    # 'gemini' for cloud, 'ollama' for local
LLM_PROVIDER_ORDER=gemini    # Cloud: gemini only (no local Ollama)

# --- LOCAL DEVELOPMENT (default, uncomment for local) ---
# DEPLOY_MODE=local
# EMBEDDING_PROVIDER=ollama
# LLM_PROVIDER_ORDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen3:1.7b
# EMBEDDING_MODEL=bge-m3

# --- OPTIONAL (extra cloud AI providers for fallback) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- SETTINGS ---
WHISPER_MODEL_SIZE=base
ENABLE_KNOWLEDGE_GRAPH=true
RETRIEVAL_TOP_K=6
RERANK_THRESHOLD=0.42
MAX_VERIFIER_RETRIES=2
ENABLE_RERANKER=false
PORT=786
